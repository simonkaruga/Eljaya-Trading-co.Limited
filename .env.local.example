# ── Sanity (create a free project at https://www.sanity.io/manage) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Token with "Editor" rights. Used to save contact-form enquiries into the
# admin panel and by `npm run seed`. Server-side only, never exposed.
SANITY_API_WRITE_TOKEN=

# Shared secret for the Sanity webhook that refreshes the site on publish.
SANITY_REVALIDATE_SECRET=

# ── Email notifications for new enquiries (https://resend.com) ──
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Eljaya Website <website@eljayatradingco.com>
CONTACT_TO_EMAIL=eljayasupplies@gmail.com

NEXT_PUBLIC_SITE_URL=https://eljayatradingco.com
